<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/product.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <% if (errorMessages) { %>
            <div class="user-message user-message--error">
                <% for (let msg of errorMessages) { %>
                   <p><%= msg %></p> 
                <% } %>
            </div>
        <% } %>
        <form class="product-form" action="<% if (editing) { %> /admin/edit-product <% } else { %> /admin/add-product <% } %>" method='post' enctype="multipart/form-data">
            <div class="form-control">
                <label for="title">Title</label>
                <input 
                class='<%= validationErrors.find(err=> err.path === "title") ? "invalid" : "" %>'
                type="text"
                name="title"
                id="title"
                value="<%= editing ? product.title : postAddProduct.title %>">
            </div>
            <!-- <div class="form-control">
                <label for="imageUrl">Image URL</label>
                <input
                class='<%= validationErrors.find(err=> err.path === "imageUrl") ? "invalid" : "" %>'
                type="text"
                name="imageUrl"
                id="imageUrl"
                value="<%= editing ? product.imageUrl : postAddProduct.imageUrl %>">
            </div> -->
            <div class="form-control">
                <label for="image">Image</label>
                <input
                type="file"
                name="image"
                id="image"
            </div>
            <div class="form-control">
                <label for="price">Price</label>
                <input
                class='<%= validationErrors.find(err=> err.path === "price") ? "invalid" : "" %>'
                type="number"
                name="price"
                id="price"
                value="<%= editing ? +product.price : postAddProduct.price %>" step="0.01">
            </div>
            <div class="form-control">
                <label for="description">Description</label>
                <textarea
                class='<%= validationErrors.find(err=> err.path === "description") ? "invalid" : "" %>'
                name="description"
                id="description"
                rows="5"><%= editing ? product.description : postAddProduct.description %></textarea>
            </div>
            <% if (editing) { %>
            <input type="hidden" name="productId" id="productId" value="<%= product._id %>">
            <% } %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit"><%= editing ? "Edit Product" : "Add Product" %></button>
        </form>
        
    </main>
<%- include('../includes/end.ejs') %>